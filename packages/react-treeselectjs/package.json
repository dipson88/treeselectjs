{
  "name": "react-treeselectjs",
  "version": "1.0.3",
  "description": "React tree select component with nested options, search, checkboxes, and multi-select support",
  "main": "./dist/react-treeselectjs.umd.js",
  "module": "./dist/react-treeselectjs.mjs",
  "types": "./dist/react-treeselectjs.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/react-treeselectjs.d.ts",
        "default": "./dist/react-treeselectjs.mjs"
      },
      "require": {
        "types": "./dist/react-treeselectjs.d.ts",
        "default": "./dist/react-treeselectjs.umd.js"
      }
    },
    "./dist/react-treeselectjs.css": {
      "import": "./dist/react-treeselectjs.css",
      "require": "./dist/react-treeselectjs.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "check": "biome check --write .",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipson88/treeselectjs.git",
    "directory": "packages/react-treeselectjs"
  },
  "keywords": [
    "react",
    "react-component",
    "treeselectjs",
    "treeselect",
    "tree-select",
    "tree select",
    "react-tree-select",
    "tree-select-react",
    "tree",
    "select",
    "dropdown",
    "multiselect",
    "multi-select",
    "multiple-select",
    "nested-options",
    "hierarchical",
    "hierarchy",
    "groupselect",
    "component",
    "ui",
    "javascript",
    "typescript",
    "ts"
  ],
  "author": "Dzmitry Zhuraukou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dipson88/treeselectjs/issues"
  },
  "homepage": "https://dipson88.github.io/treeselectjs",
  "dependencies": {
    "treeselectjs": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "files": [
    "dist"
  ]
}
