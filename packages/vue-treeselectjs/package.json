{
  "name": "vue-treeselectjs",
  "version": "0.9.2",
  "description": "Treeselect Vue Component",
  "main": "./dist/vue-treeselectjs.umd.js",
  "module": "./dist/vue-treeselectjs.mjs",
  "types": "./dist/vue-treeselectjs.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/vue-treeselectjs.d.ts",
        "default": "./dist/vue-treeselectjs.mjs"
      },
      "require": {
        "types": "./dist/vue-treeselectjs.d.ts",
        "default": "./dist/vue-treeselectjs.umd.js"
      }
    },
    "./dist/vue-treeselectjs.css": {
      "import": "./dist/vue-treeselectjs.css",
      "require": "./dist/vue-treeselectjs.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "typecheck": "vue-tsc --project tsconfig.json --noEmit && vue-tsc --project tsconfig.node.json --noEmit",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dipson88/treeselectjs.git",
    "directory": "packages/vue-treeselectjs"
  },
  "keywords": [
    "vue",
    "treeselectjs",
    "treeselect",
    "select",
    "groupselect",
    "js",
    "ts",
    "typescript",
    "multi-select",
    "multiple-select"
  ],
  "author": "Dzmitry Zhuraukou",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dipson88/treeselectjs/issues"
  },
  "homepage": "https://github.com/dipson88/treeselectjs/tree/main/packages/vue-treeselectjs#readme",
  "dependencies": {
    "treeselectjs": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.4",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "jsdom": "^30.0.1",
    "resize-observer-polyfill": "^1.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "peerDependencies": {
    "vue": "^3.x"
  },
  "files": [
    "dist"
  ]
}
