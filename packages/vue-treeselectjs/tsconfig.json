{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "treeselectjs-test-helpers": ["../treeselectjs/__tests__/testHelpers"]
    }
  },
  "include": ["src", "__tests__"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
