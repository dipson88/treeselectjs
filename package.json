{
  "name": "treeselectjs-monorepo",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "check": "pnpm -r check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "clear-dist": "node .script/removeDist.js",
    "clear-modules": "node .script/removeNodeModules.js",
    "clear-all": "node .script/removeDist.js && node .script/removeNodeModules.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.0"
  }
}
